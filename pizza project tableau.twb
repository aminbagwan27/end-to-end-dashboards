      <column caption='calculate_field 1' datatype='string' name='[Calculation_0742504376815616]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_time]&gt;=#08.00.00# and [order_time] &lt; #12.00.00# THEN &quot;morning&quot;&#13;&#10;ELSEIF [order_time] &gt;= #12.00.00# and [order_time] &lt; #17.00.00# THEN &apos;afternoon&apos;&#13;&#10;ELSEIF [order_time] &gt;= #17.00.00# and [order_time] &lt;#21.00.00# THEN &apos;evening&apos;&#13;&#10;ELSE &apos;night&apos;&#13;&#10;end' />
      </column>
      <column caption='total/unit price' datatype='real' name='[Calculation_0742504383225859]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 0742504382296066] = &quot;total price&quot; THEN[total_price]&#13;&#10;ELSEIF [Parameters].[Parameter 0742504382296066] = &quot;unir price&quot; THEN [unit_price]&#13;&#10;end' />
      </column>
